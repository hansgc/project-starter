{
  "name": "Backup",
  "dockerComposeFile": ["../aDespliegue/dev/docker-compose.yml"],
  "service": "backup",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.makefile-tools",
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
