{# templates/security/login.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Iniciar sesión{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div class="login-card">

        <div class="login-header">
            <h1>Iniciar sesión</h1>
        </div>

        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey | trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">

            <div class="form-group">
                <label for="login">Usuario</label>
                <input
                    type="text"
                    id="login"
                    name="_username"
                    value="{{ last_username }}"
                    class="form-control"
                    autocomplete="username"
                    autofocus
                    required
                />
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <input
                    type="password"
                    id="password"
                    name="_password"
                    class="form-control"
                    autocomplete="current-password"
                    required
                />
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn btn-primary btn-block">
                Ingresar
            </button>

        </form>

    </div>
</div>

<style>
    .login-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: #f5f5f5;
    }
    .login-card {
        background: #fff;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(0,0,0,.1);
        width: 100%;
        max-width: 380px;
    }
    .login-header h1 {
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
        text-align: center;
    }
    .form-group {
        margin-bottom: 1rem;
    }
    .form-group label {
        display: block;
        margin-bottom: .4rem;
        font-weight: 600;
        font-size: .9rem;
    }
    .form-control {
        width: 100%;
        padding: .55rem .75rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 1rem;
        box-sizing: border-box;
    }
    .form-control:focus {
        outline: none;
        border-color: #4e73df;
        box-shadow: 0 0 0 2px rgba(78,115,223,.25);
    }
    .btn-primary {
        width: 100%;
        padding: .65rem;
        background: #4e73df;
        color: #fff;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        cursor: pointer;
        margin-top: .5rem;
    }
    .btn-primary:hover { background: #2e59d9; }
    .alert-danger {
        background: #fde8e8;
        color: #c0392b;
        padding: .75rem 1rem;
        border-radius: 4px;
        margin-bottom: 1rem;
        font-size: .9rem;
    }
</style>
{% endblock %}
